configuration {
modes:              "run,emoji:/usr/bin/rofimoji,ssh,drun";
sorting-method:     "fzf";
show-icons:         true;

terminal:           "kitty";
editor:             "nvim";

matching:           "fuzzy";
case-sensitive:     false;

drun-match-fields:  "name";

display-drun:       "󰀻 Apps:";
display-run:        " Menu:";
display-ssh:        " SSH:";
display-emoji:      "󱃞 Emoji";

kb-move-char-forward: "Right";
kb-move-char-back:    "Left";
kb-mode-next:         "Alt+Right";
kb-mode-previous:     "Alt+Left";

}

* {
  bg0:     #1d2021;
  bg1:     #282828;
  bg2:     #32302f;
  bg3:     #3c3836;
  bg4:     #504945;

  fg0:     #d4be98;
  fg1:     #c0a36e;
  fg2:     #928374;

  red:     #ea6962;
  green:   #a9b665;
  yellow:  #d8a657;
  blue:    #7daea3;
  magenta: #d3869b;
  cyan:    #89b482;
  orange:  #e78a4e;

  accent:  @yellow;
  urgent:  @red;

  background-color: transparent;
  text-color: @fg1;
  }

/* ----------------------------------------------------- */
/* Window */
/* ----------------------------------------------------- */

window {
width: 500px;

background-color: @bg0;

border: 2px;
border-color: @yellow;

border-radius: 6px;

padding: 0;

}

/* ----------------------------------------------------- */
/* Main Box */
/* ----------------------------------------------------- */

mainbox {
background-color: transparent;


children: [
    inputbar,
    message,
    mode-switcher,
    listview
];

spacing: 0;
padding: 10px;

}

/* ----------------------------------------------------- */
/* Search Bar */
/* ----------------------------------------------------- */

inputbar {
background-color: @bg2;

border-radius: 8px;

padding: 10px 14px;

margin: 0px 0px 10px 0px;

children: [ prompt, entry ];

spacing: 8px;

}

prompt {
background-color: transparent;

text-color: @green;

font: "CaskaydiaCove Nerd Font Italic 14";

}

entry {
background-color: transparent;

text-color: @fg0;

placeholder-color: @fg2;

font: "CaskaydiaCove Nerd Font Italic 10";

}

/* ----------------------------------------------------- */
/* Text */
/* ----------------------------------------------------- */

element-text {
background-color: transparent;

text-color: inherit;

vertical-align: 0.5;

font: "CaskaydiaCove Nerd Font Italic 12";

}

textbox {
background-color: transparent;

text-color: @fg2;

font: "CaskaydiaCove Nerd Font Italic 12";

}

/* ----------------------------------------------------- */
/* Mode Switcher */
/* ----------------------------------------------------- */

mode-switcher {
background-color: transparent;

margin: 0px 0px 10px 0px;

spacing: 6px;

}

button {
background-color: @bg2;

text-color: @magenta;

border-radius: 6px;

padding: 5px 12px;

}

button selected {
background-color: @yellow;

text-color: @bg0;

}

/* ----------------------------------------------------- */
/* List View */
/* ----------------------------------------------------- */

listview {
background-color: transparent;

columns: 1;

lines: 5;

spacing: 8px;

fixed-height: false;

border: 0px;

}

/* ----------------------------------------------------- */
/* Scrollbar */
/* ----------------------------------------------------- */

scrollbar {
width: 4px;

background-color: @bg2;

border-radius: 4px;

}

scrollbar handle {
background-color: @yellow;

border-radius: 4px;

}

/* ----------------------------------------------------- */
/* Elements */
/* ----------------------------------------------------- */

element {
background-color: transparent;

text-color: @fg1;

border-radius: 4px;

padding: 8px 10px;

spacing: 8px;

orientation: horizontal;

}

/* Normal rows */

element normal.normal {
background-color: transparent;
text-color: @fg1;
}

element alternate.normal {
background-color: transparent;
text-color: @fg1;
}

/* Active rows */

element normal.active {
background-color: transparent;
text-color: @cyan;
}

element alternate.active {
background-color: transparent;
text-color: @cyan;
}

/* Urgent rows */

element normal.urgent {
background-color: transparent;
text-color: @urgent;
}

element alternate.urgent {
background-color: transparent;
text-color: @urgent;
}

/* Selected */

element selected.normal {
background-color: @bg3;

text-color: @fg0;

border: 0px 0px 0px 3px;

border-color: @yellow;

}

element selected.active {
background-color: @bg3;

text-color: @cyan;

border: 0px 0px 0px 3px;

border-color: @cyan;

}

element selected.urgent {
background-color: @bg3;

text-color: @urgent;

border: 0px 0px 0px 3px;

border-color: @urgent;

}

/* Icons */

element-icon {
background-color: transparent;

size: 24px;

}

